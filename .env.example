# URL do projeto Supabase (Dashboard > Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública anon/publishable (Dashboard > Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave service_role / secret — SOMENTE servidor. Usada no gerenciamento de usuários e scripts.
SUPABASE_SERVICE_ROLE_KEY=
# Fuso horário usado para "hoje" e formatação de datas
NEXT_PUBLIC_APP_TIMEZONE=America/Sao_Paulo
